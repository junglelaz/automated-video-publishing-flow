/** Initial setup is deliberate; ordinary passing videos need no per-video approval. */
function discoverCloudAuthorization(){const resource=cloudJson_(fetch_(OC.endpoint+'/.well-known/oauth-protected-resource',{},true),[200]);if(resource.resource!==OC.endpoint||!Array.isArray(resource.authorization_servers)||!resource.authorization_servers.includes(OC.issuer))throw new Error('UNTRUSTED_AUTH_DISCOVERY');const metadata=cloudJson_(fetch_(OC.issuer+'/.well-known/oauth-authorization-server',{},true),[200]);if(metadata.issuer!==OC.issuer)throw new Error('UNTRUSTED_AUTH_ISSUER');props_().setProperty('OPUS_CLOUD_AUTH_METADATA',JSON.stringify(metadata));cloudAuthMeta_();console.log('Official OpusClip authorization metadata verified.');}
function registerCloudClient(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))throw new Error('BUSY');try{const p=props_(),m=cloudAuthMeta_(),existing=JSON.parse(p.getProperty('OPUS_CLOUD_CLIENT')||'{}');if(existing.client_id){console.log('Public OAuth client already registered.');return;}if(existing.status==='creating')throw new Error('CLIENT_REGISTRATION_RECONCILIATION_REQUIRED');p.setProperty('OPUS_CLOUD_CLIENT',JSON.stringify({status:'creating'}));const c=cloudJson_(fetch_(m.registration_endpoint,{method:'post',contentType:'application/json',payload:JSON.stringify({client_name:'Private cloud video workflow',token_endpoint_auth_method:'none',grant_types:['authorization_code','refresh_token'],redirect_uris:[cloudCallbackUri_()],response_types:['code'],scope:OC.scopes})},false),[200,201]);if(!c.client_id||c.client_secret)throw new Error('UNEXPECTED_CLIENT_REGISTRATION');p.setProperty('OPUS_CLOUD_CLIENT',JSON.stringify({client_id:c.client_id,status:'registered'}));console.log('OAuth client registered privately. Run startCloudBrowserAuthorization.');}finally{lock.releaseLock();}}
function inspectConnectedDestinations(){const w=cloudTool_('opusclip_whoami',{});if(w.org_id!==OC.org||!w.has_api_access)throw new Error('WRONG_OPUS_ORGANIZATION');console.log(JSON.stringify(cloudTool_('opusclip_list_social_accounts',{})));}
function verifyPrivateFolder_(){const r=cloudJson_(drive_('files/'+JL.folder+'?fields=id,mimeType,trashed'),[200]);if(r.id!==JL.folder||r.trashed||r.mimeType!=='application/vnd.google-apps.folder')throw new Error('SOURCE_FOLDER_UNAVAILABLE');}
function enableAutomaticWorkflow(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))throw new Error('BUSY');try{const p=props_();requiredSetting_('OPUSCLIP_API_KEY');JL.notify;verifyPrivateFolder_();verifyDestinations_();const w=cloudTool_('opusclip_whoami',{});if(w.org_id!==OC.org||!w.has_api_access)throw new Error('WRONG_OPUS_ORGANIZATION');if(!p.getProperty('OPUS_CLOUD_REFRESH_TOKEN'))throw new Error('RENEWABLE_AUTH_REQUIRED');checkUsage_();const current=ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()==='tick');if(!current.length)ScriptApp.newTrigger('tick').timeBased().everyMinutes(5).create();if(current.length>1)throw new Error('DUPLICATE_TRIGGER_RECONCILIATION_REQUIRED');captureBaseline_();p.setProperties({INTAKE_ENABLED:'true',SUBMIT_ENABLED:'true',AUTO_WORKFLOW_ENABLED:'true'});console.log(JSON.stringify({enabled:true,intervalMinutes:5,publicPublishing:p.getProperty('PUBLICATION_ENABLED')==='true',ownerApprovalRequired:false}));}finally{lock.releaseLock();}}
function pauseAutomaticWorkflow(){props_().setProperties({INTAKE_ENABLED:'false',SUBMIT_ENABLED:'false',AUTO_WORKFLOW_ENABLED:'false'});console.log('Worker paused. Existing file and publication records were preserved.');}
function status(){const p=props_(),rows=Object.entries(p.getProperties()).filter(x=>x[0].startsWith('file:')).map(x=>JSON.parse(x[1]));console.log(JSON.stringify({intakeEnabled:p.getProperty('INTAKE_ENABLED')==='true',automaticWorkflow:p.getProperty('AUTO_WORKFLOW_ENABLED')==='true',publicPublishing:p.getProperty('PUBLICATION_ENABLED')==='true',files:rows.map(s=>({fileId:s.fileId,projectId:s.projectId,status:s.status,stage:s.flow?.stage,error:s.flow?.error||s.error,posts:s.flow?.posts})),lastScheduledTick:JSON.parse(p.getProperty('LAST_SCHEDULED_TICK')||'null')}));}

function captureBaseline_(){if(props_().getProperty('BASELINE_CAPTURED')==='true')return;for(const id of discover_())if(!load_(id))save_({fileId:id,status:'ignored_existing'});props_().setProperty('BASELINE_CAPTURED','true');}
