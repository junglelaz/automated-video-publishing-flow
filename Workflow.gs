/** Automatic editing, actual-render QC and allowlisted publication. */
function safeTitle_(name){const t=String(name||'').replace(/\.(mov|mp4|mkv)$/i,'').normalize('NFKD').replace(/[^\x20-\x7e]/g,'').replace(/\s+/g,' ').trim();if(!t)throw new Error('TITLE_UNAVAILABLE');return t.slice(0,95);}
function safeHook_(title){let h=title.replace(/[^A-Za-z0-9 ,.!?'":;-]/g,'').trim();if(h.length>72){h=h.slice(0,72).replace(/\s+\S*$/,'');}if(!h||!/[A-Za-z]/.test(h))throw new Error('HOOK_UNAVAILABLE');return h;}
function rawClip_(s){const r=cloudJson_(opus_('exportable-clips/'+s.projectId+'.'+s.flow.clipId+'?include=editingScript','get',undefined,true),[200]);return r.data||r;}
function artifactId_(c,m){return sha256_([String(c.uriForExport||'').split('&hdnts=')[0],m.etag,m.sizeBytes,m.durationSeconds,m.width,m.height].join('|'));}
function scriptId_(c){return sha256_(JSON.stringify({script:c.editingScript,pref:c.renderPref,override:c.renderPreferenceOverride}));}
function spokenId_(text){return sha256_(String(text||'').toLowerCase().replace(/__silence/g,'').replace(/[\s.,!?;:'"-]/g,''));}
function checkUsage_(){const u=cloudTool_('opusclip_get_usage',{});if(!(u.credits?.remaining_minutes>=30)||(!u.uncapped&&u.monthly?.remaining<10)||!(u.concurrent?.used<u.concurrent?.limit))throw new Error('OPUS_BUDGET_OR_CONCURRENCY_LIMIT');return u;}
function centeredHook_(script){let n=0;for(const t of script.tracks||[])if(t.trackType==='TextOverlayTrack')for(const sec of t.sections||[])for(const seg of sec.segments||[]){if(sec.sectionTimeline?.in!==0||sec.sectionTimeline?.out!==3000)throw new Error('UNEXPECTED_HOOK_TIMING');seg.positionAdjustment={type:'CPct',xPct:0,yPct:-0.2,wPct:0.75,hPct:0.2};n++;}if(n!==1)throw new Error('HOOK_NOT_UNIQUE');return script;}
function verifyDestinations_(){const a=cloudTool_('opusclip_list_social_accounts',{}).accounts||[];for(const d of destinations_()){if(!a.some(x=>x.platform===d.platform&&x.post_account_id===d.postAccountId&&String(x.sub_account_id||'')===String(d.subAccountId||'')))throw new Error('DESTINATION_CONNECTION_CHANGED');}}
function flowNotice_(s,code){notify_(s,code);}
function stepIntent_(s,kind,call,next){s.flow.intent={kind:kind,at:new Date().toISOString()};save_(s);call();delete s.flow.intent;s.flow.stage=next;s.flow.failures=0;save_(s);}
function holdFlow_(s,code){s.status='workflow_failed';s.flow.stage='held';s.flow.error=code;save_(s);flowNotice_(s,code);}
function qcObject_(r){let t=r.understanding||r.understandingText||r.text||r.result?.text||r.analysis;if(typeof t==='object')return t;if(typeof t!=='string')throw new Error('QC_RESPONSE_SCHEMA_UNKNOWN');t=t.trim().replace(/^```(?:json)?\s*/,'').replace(/\s*```$/,'');try{return JSON.parse(t);}catch(_){throw new Error('QC_RESPONSE_NOT_JSON');}}
function qcPass_(r,hook){const q=qcObject_(r);if(!q.checks||QC_CHECKS.some(k=>q.checks[k]!==true)||q.hookText!==hook||!(q.hookEndSeconds>=2.7&&q.hookEndSeconds<=3.3))return {passed:false,reason:String(q.observations||'Rendered video failed required checks').slice(0,500)};return {passed:true,reason:String(q.observations||'All rendered picture and sound checks passed').slice(0,500)};}
function settledQc_(r){return r.status==='succeeded'&&r.billingStatus==='settled'&&r.pendingCredits===0&&Number.isFinite(r.chargedCredits)&&r.chargedCredits>=0&&!!(r.jobId||r.job_id);}
function uploadExport_(s,c,m,deadline){const f=s.flow;let u=f.reviewUpload;if(!u){stepIntent_(s,'qc_upload_slot',()=>{const r=cloudJson_(opus_('upload-links-v2','post',{usecase:'LocalUpload'},false),[200,201]);if(!r.url?.startsWith('https://storage.googleapis.com/')||!r.uploadId||!r.requiredHeaders)throw new Error('BAD_QC_SLOT');f.reviewUpload={status:'slot_created',uploadId:r.uploadId,signedUrl:r.url,requiredHeaders:r.requiredHeaders,offset:0};},'qc_upload');u=f.reviewUpload;}
  if(u.status==='slot_created'){stepIntent_(s,'qc_upload_session',()=>{const r=expect_(fetch_(u.signedUrl,{method:'post',headers:u.requiredHeaders,payload:''},false),[200,201]);u.session=header_(r,'Location');if(!u.session.startsWith('https://storage.googleapis.com/'))throw new Error('BAD_QC_SESSION');u.status='uploading';delete u.signedUrl;delete u.requiredHeaders;},'qc_upload');}
  if(u.status==='uploading'){u.offset=nextOffset_(fetch_(u.session,{method:'put',contentType:'application/octet-stream',headers:{'Content-Range':'bytes */'+m.sizeBytes},payload:''},true),m.sizeBytes);save_(s);while(u.offset<m.sizeBytes&&Date.now()<deadline){const b=remoteRange_(c.uriForExport,u.offset,Math.min(JL.chunk,m.sizeBytes-u.offset));if(b.total!==m.sizeBytes||b.etag!==m.etag)throw new Error('EXPORT_CHANGED');const end=u.offset+b.bytes.length-1;const r=fetch_(u.session,{method:'put',contentType:'application/octet-stream',headers:{'Content-Range':'bytes '+u.offset+'-'+end+'/'+m.sizeBytes},payload:b.bytes},false);const off=nextOffset_(r,m.sizeBytes);if(off<=u.offset||off>end+1)throw new Error('BAD_QC_UPLOAD_PROGRESS');u.offset=off;save_(s);}if(u.offset===m.sizeBytes){u.status='uploaded';delete u.session;f.stage='qc_start';save_(s);}}
}
function finalMatches_(s,c){const f=s.flow;if(c.renderAsVideoFile?.pending||!c.uriForExport||scriptId_(c)!==f.scriptHash)throw new Error('RENDER_CHANGED_AFTER_QC');const m=inspectMp4_(c.uriForExport);if(artifactId_(c,m)!==f.artifactHash)throw new Error('EXPORT_CHANGED_AFTER_QC');assertUnchanged_(s,meta_(s.fileId));return m;}
function reconcilePosts_(s){const f=s.flow,r=cloudJson_(opus_('post-tasks?q=findByProjectId&projectId='+s.projectId,'get',undefined,true),[200]),posts=Array.isArray(r)?r:Array.isArray(r.data)?r.data:r.data?.data||[];for(const d of destinations_()){const own=f.posts[d.platform];if(!own)continue;const match=posts.filter(x=>x.projectId===s.projectId&&x.clipId===f.clipId&&x.platform===d.platform&&String(x.subAccountId||'')===String(d.subAccountId||'')&&(!own.taskId||x.postId===own.taskId));if(match.length>1)throw new Error('AMBIGUOUS_DESTINATION_POSTS');if(match.length===1){const x=match[0];own.taskId=x.postId;own.status=x.status;if(x.extVideoLink)own.url=x.extVideoLink;if(x.status==='failed')own.failure=String(x.errorMessage||'PLATFORM_FAILED').slice(0,200);}}save_(s);}
function workflowStep_(s,deadline){const f=s.flow,args={projectId:s.projectId,clipId:f.clipId};if(f.intent)throw new Error('AMBIGUOUS_'+f.intent.kind.toUpperCase());if(Date.now()-f.startedAt>48*3600000)throw new Error('WORKFLOW_TIMEOUT');
  if(f.stage==='await_clip'){const r=cloudTool_('opusclip_list_clips',{projectId:s.projectId});if(!r.clips?.length){if(/FAIL|ERROR/i.test(r.stage||''))throw new Error('PROJECT_PROCESSING_FAILED');return false;}if(r.clips.length!==1)throw new Error('FULL_LENGTH_OUTPUT_NOT_UNIQUE');f.clipId=r.clips[0].clip_id;f.stage='pauses';save_(s);return true;}
  const detail=cloudTool_('opusclip_describe_clip',args);if(detail.render_pending)return false;
  const c=rawClip_(s);
  if(f.stage==='pauses'){if(!(detail.duration_sec>=s.sourceDurationSec-1)||!detail.transcript)throw new Error('FULL_SOURCE_CONTENT_NOT_AVAILABLE');f.spokenHash=spokenId_(detail.transcript);const t=cloudTool_('opusclip_get_clip_tracks',args);if((t.tracks||[]).some(x=>/VoiceEnhancement|enhanced.*audio|audio.*enhance/i.test(typeof x==='string'?x:JSON.stringify(x))))throw new Error('ENHANCED_AUDIO_PAUSE_SYNC_UNSUPPORTED');stepIntent_(s,'remove_pauses',()=>cloudTool_('opusclip_edit_clip_timeline',Object.assign({},args,{ops:[{op:'remove_pauses',minPauseSec:0.5}]})),'captions');return false;}
  if(f.stage==='captions'){stepIntent_(s,'captions',()=>cloudTool_('opusclip_edit_clip_captions',Object.assign({},args,{ops:[{op:'set_captions',enabled:true},{op:'set_emoji',enabled:false},{op:'set_keyword_highlight',enabled:true},{op:'set_style',captionPosition:'bottom',captionColor:'#FFFFFF',highlightColor:'#04f827',uppercase:false}]})),'hook');return false;}
  if(f.stage==='hook'){stepIntent_(s,'hook',()=>cloudTool_('opusclip_edit_clip_elements',Object.assign({},args,{ops:[{op:'add_text_overlay',text:f.hook,atClipSec:0,durationSec:3,position:'middle'}]})),'grade');return false;}
  if(f.stage==='grade'){stepIntent_(s,'grade',()=>cloudJson_(opus_('exportable-clips/'+s.projectId+'.'+f.clipId+'/re-render','post',{editingScript:centeredHook_(c.editingScript),renderPreferenceOverride:{autoColorIntensity:0.25}},false),[200,201,202]),'export');return false;}
  if(f.stage==='export'){if(!f.spokenHash||spokenId_(detail.transcript)!==f.spokenHash)throw new Error('SPOKEN_CONTENT_CHANGED');const r=cloudTool_('opusclip_export_clip',Object.assign({},args,{target:'hd'}));if(r.status==='unavailable')throw new Error('HD_EXPORT_UNAVAILABLE');if(r.status!=='ready')return false;const final=rawClip_(s),m=inspectMp4_(final.uriForExport);if(!(m.width>=1080&&m.height>=1920&&Math.abs(m.width/m.height-9/16)<0.01&&m.durationSeconds>3&&m.durationSeconds<=180))throw new Error('HD_OR_DURATION_REQUIREMENT_FAILED');if(final.renderPref?.autoColorIntensity!==0.25)throw new Error('COLOUR_CORRECTION_NOT_APPLIED');f.metadata=m;f.scriptHash=scriptId_(final);f.artifactHash=artifactId_(final,m);f.stage='qc_upload';save_(s);return true;}
  if(f.stage==='qc_upload'){if(scriptId_(c)!==f.scriptHash||artifactId_(c,inspectMp4_(c.uriForExport))!==f.artifactHash)throw new Error('EXPORT_CHANGED');uploadExport_(s,c,f.metadata,deadline);return f.stage==='qc_start';}
  if(f.stage==='qc_start'){if(Date.now()>deadline-45000)return false;checkUsage_();const prompt=reviewPrompt_(f.hook);f.qcKey='jl-qc-v1-'+sha256_(f.artifactHash+prompt);stepIntent_(s,'rendered_qc',()=>{const r=cloudTool_('opusclip_analyze_reference_media',{mediaType:'video',uploadId:f.reviewUpload.uploadId,durationSeconds:f.metadata.durationSeconds,fps:2,maxOutputTokens:2500,idempotencyKey:f.qcKey,prompt:prompt});f.qcJobId=r.jobId||r.job_id;if(!f.qcJobId)throw new Error('QC_JOB_RECEIPT_MISSING');},'qc_wait');return true;}
  if(f.stage==='qc_wait'){const r=cloudTool_('opusclip_get_reference_analysis',{jobId:f.qcJobId});if(!settledQc_(r)){if(/failed|error|uncertain/i.test(r.status||''))throw new Error('QC_OR_BILLING_UNCERTAIN');return false;}f.qcCost=r.chargedCredits;const q=qcPass_(r,f.hook);f.qc=q;f.qc.artifactHash=f.artifactHash;if(!q.passed)throw new Error('RENDERED_QUALITY_CHECK_FAILED');finalMatches_(s,c);f.stage='publish';f.posts={};save_(s);return true;}
  if(f.stage==='publish'){if(f.qc?.passed!==true||f.qc.artifactHash!==f.artifactHash)throw new Error('QC_APPROVAL_MISSING_OR_STALE');finalMatches_(s,c);verifyDestinations_();if(props_().getProperty('PUBLICATION_ENABLED')!=='true'){s.status='dry_run_complete';f.stage='complete';save_(s);flowNotice_(s,'DRY_RUN_QC_PASSED_NO_PUBLIC_POSTS');return false;}reconcilePosts_(s);for(const d of destinations_()){if(f.posts[d.platform])continue;f.posts[d.platform]={status:'intent',at:new Date().toISOString(),postAccountId:d.postAccountId,subAccountId:d.subAccountId||null};save_(s);const p=Object.assign({},args,d,{title:f.title,description:f.title+'\n\n#Video',privacy:'public'});delete p.platform;const r=cloudTool_('opusclip_create_post_task',p);const id=r.post_task_id||r.postTaskId;if(!id)throw new Error('POST_RECEIPT_UNCERTAIN');f.posts[d.platform].taskId=id;f.posts[d.platform].status='submitted';save_(s);}f.stage='posted_wait';save_(s);return false;}
  if(f.stage==='posted_wait'){reconcilePosts_(s);if(destinations_().some(d=>f.posts[d.platform]?.status==='failed'))throw new Error('PLATFORM_PUBLICATION_FAILED');if(destinations_().every(d=>f.posts[d.platform]?.status==='posted'&&f.posts[d.platform]?.url)){s.status='published';f.stage='complete';f.completedAt=new Date().toISOString();save_(s);flowNotice_(s,'PUBLISHED_TO_ALL_FOUR');}return false;}return false;
}
function workflowTick_(){const lock=LockService.getScriptLock();if(!lock.tryLock(1000))return;const start=Date.now(),p=props_(),day=new Date().toISOString().slice(0,10);let b=JSON.parse(p.getProperty('runtime')||'{}');if(b.day!==day)b={day:day,ms:0};try{if(p.getProperty('AUTO_WORKFLOW_ENABLED')!=='true'||b.ms>=JL.dailyMs)return;const states=Object.entries(p.getProperties()).filter(x=>x[0].startsWith('file:')).map(x=>JSON.parse(x[1])).filter(s=>s.projectId&&s.status!=='published'&&s.status!=='workflow_failed'&&s.status!=='dry_run_complete');for(const s of states){if(s.status!=='qc_required'&&!s.flow)continue;if(!s.flow){const m=meta_(s.fileId);assertUnchanged_(s,m);s.flow={stage:'await_clip',title:safeTitle_(m.name),hook:safeHook_(safeTitle_(m.name)),startedAt:Date.now(),failures:0};s.status='workflow';save_(s);}if(s.flow.nextAttemptAt>Date.now())continue;try{for(let n=0;n<8&&Date.now()<start+150000;n++)if(!workflowStep_(s,start+150000))break;s.flow.failures=0;save_(s);}catch(e){const code=/^[A-Z0-9_]+$/.test(e.message)?e.message:'WORKFLOW_INTERNAL_ERROR';s.flow.failures=(s.flow.failures||0)+1;s.flow.nextAttemptAt=Date.now()+Math.min(6*3600000,60000*Math.pow(2,s.flow.failures));if(s.flow.intent||s.flow.failures>=5||/AMBIGUOUS|FAILED|UNSUPPORTED|CHANGED|UNIQUE|UNCERTAIN|SCHEMA|MISSING_OR_STALE/.test(code))holdFlow_(s,code);else{save_(s);console.log(JSON.stringify({fileId:s.fileId,stage:s.flow.stage,retry:s.flow.failures,code:code}));}}break;}}finally{b.ms+=Date.now()-start;p.setProperty('runtime',JSON.stringify(b));lock.releaseLock();}}
function tick(e){let ok=false;try{intakeTick_();workflowTick_();ok=true;}finally{const record=JSON.stringify({at:new Date().toISOString(),scheduled:!!(e&&e.triggerUid),ok:ok});props_().setProperty('LAST_TICK',record);if(e&&e.triggerUid)props_().setProperty('LAST_SCHEDULED_TICK',record);}}
